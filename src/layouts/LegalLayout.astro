---
import BaseLayout from "./BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import DraftNotice from "../components/DraftNotice.astro";
import { site } from "../data/site";

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  lede: string;
  lastUpdated: string;
}

const { title, description, eyebrow, lede, lastUpdated } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <PageHeader eyebrow={eyebrow} title={title} lede={lede} width="22ch" />

  <section class="border-t border-navy-900/10 bg-paper">
    <div class="shell py-16 md:py-24">
      <div class="grid gap-14 lg:grid-cols-[0.28fr_0.72fr] lg:gap-16">
        <div class="lg:sticky lg:top-28 lg:self-start">
          <DraftNotice />
          <dl class="mt-8 flex flex-col gap-3 border-t border-navy-900/12 pt-6 text-[0.8125rem]">
            <div class="flex flex-col gap-1">
              <dt class="eyebrow text-ink-3">Applies to</dt>
              <dd class="text-ink-2">{site.legalName} and its products</dd>
            </div>
            <div class="flex flex-col gap-1">
              <dt class="eyebrow text-ink-3">Last updated</dt>
              <dd class="text-ink-2">{lastUpdated}</dd>
            </div>
            <div class="flex flex-col gap-1">
              <dt class="eyebrow text-ink-3">Grievance officer</dt>
              <dd class="text-ink-2">
                <a href="/grievance" class="text-gold-700 underline underline-offset-4">
                  See the escalation route
                </a>
              </dd>
            </div>
          </dl>
        </div>

        <div
          class="max-w-[70ch] text-[0.9375rem] leading-[1.75] text-ink-2
            [&_a]:text-gold-700 [&_a]:underline [&_a]:underline-offset-4
            [&_h2]:mt-12 [&_h2]:mb-4 [&_h2]:text-h3 [&_h2]:font-semibold [&_h2]:text-ink
            [&_h2:first-child]:mt-0
            [&_h3]:mt-8 [&_h3]:mb-3 [&_h3]:font-medium [&_h3]:text-ink
            [&_li]:mb-2 [&_li]:pl-1
            [&_p]:mb-4 [&_strong]:text-ink [&_strong]:font-medium
            [&_ul]:mb-5 [&_ul]:list-outside [&_ul]:list-disc [&_ul]:pl-5
            [&_table]:mb-6 [&_table]:w-full [&_table]:border-collapse [&_table]:text-[0.875rem]
            [&_td]:border-t [&_td]:border-navy-900/12 [&_td]:py-3 [&_td]:pr-4 [&_td]:align-top
            [&_th]:border-b [&_th]:border-navy-900/20 [&_th]:py-3 [&_th]:pr-4 [&_th]:text-left [&_th]:font-medium [&_th]:text-ink"
        >
          <slot />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
