---
import StatusBadge from "./StatusBadge.astro";
import { verticals } from "../data/site";

interface Props {
  tone?: "dark" | "light";
  /** Renders a compact variant without the item lists. */
  compact?: boolean;
}

const { tone = "dark", compact = false } = Astro.props;
const muted = tone === "light" ? "text-navy-300" : "text-ink-2";
---

{/* The gold thread is the mark's infinity loop carried into the page structure:
    one continuous line that every entity hangs from, rather than seven loose cards. */}
<ol class="relative">
  <span
    class="absolute top-2 bottom-2 left-[7px] w-px bg-gradient-to-b from-gold-600 via-gold-500/60 to-transparent"
    aria-hidden="true"
  ></span>

  {
    verticals.map((v, i) => (
      <li class="relative pb-10 pl-9 last:pb-0 md:pb-12">
        <span
          class:list={[
            "absolute left-0 top-[7px] h-[15px] w-[15px] rotate-45 border",
            v.status === "operating"
              ? "border-gold-500 bg-gold-500"
              : tone === "light"
                ? "border-navy-400 bg-transparent"
                : "border-ink-3 bg-transparent",
          ]}
          aria-hidden="true"
        />

        <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
          <h3
            class:list={[
              "text-h3",
              tone === "light" ? "text-navy-50" : "text-ink",
            ]}
          >
            {v.name}
          </h3>
          <StatusBadge status={v.status} tone={tone} />
        </div>

        <p class:list={["mt-3 max-w-[62ch] text-[0.9375rem] leading-relaxed", muted]}>
          {v.summary}
        </p>

        {!compact && (
          <ul class="mt-4 flex flex-wrap gap-x-2 gap-y-2">
            {v.items.map((item) => (
              <li
                class:list={[
                  "border px-2.5 py-1 font-mono text-[0.6875rem] tracking-wide",
                  tone === "light"
                    ? "border-navy-700 text-navy-300"
                    : "border-navy-900/12 text-ink-3",
                ]}
                style="border-radius: var(--radius-xs)"
              >
                {item}
              </li>
            ))}
          </ul>
        )}

        <p class:list={["eyebrow mt-4", tone === "light" ? "text-navy-400" : "text-ink-3"]}>
          Memorandum · {v.objectClause}
        </p>
      </li>
    ))
  }
</ol>
