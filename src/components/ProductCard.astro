---
export type ProductCardData = {
  name: string | null;
  slug: string | null;
  tagline: string | null;
  category: string | null;
  status: 'operating' | 'mandate' | null;
  summary: string | null;
};

interface Props {
  product: ProductCardData;
}

const { product } = Astro.props;
---

<article class="group flex flex-col border border-navy-900/12 bg-paper transition-colors duration-200 hover:border-gold-600/40" style="border-radius: var(--radius-xs)">
  <a href={`/products/${product.slug}`} class="flex h-full flex-col p-6">
    <div class="flex flex-wrap items-center gap-3">
      {product.category && <span class="eyebrow text-gold-700">{product.category}</span>}
      {product.status && (
        <span class="eyebrow text-ink-3">
          {product.status === 'operating' ? 'Operating now' : 'Chartered'}
        </span>
      )}
    </div>
    <h3 class="mt-3 text-h3 text-ink transition-colors duration-200 group-hover:text-gold-700">
      {product.name}
    </h3>
    {product.tagline && <p class="mt-2 text-[0.9375rem] text-gold-700">{product.tagline}</p>}
    {product.summary && (
      <p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-ink-2">{product.summary}</p>
    )}
  </a>
</article>
