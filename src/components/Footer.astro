---
import Logo from "./Logo.astro";
import { site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="field-dark border-t border-gold-500/20">
  <div class="shell py-14 md:py-20">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr] md:gap-10">
      <div>
        <div class="flex items-center gap-3">
          <Logo variant="emblem-gold" height={34} />
          <span class="flex flex-col leading-none">
            <span class="wordmark text-[1.0625rem] text-navy-50 uppercase">{site.brandName}</span>
            <span class="mt-1 font-mono text-[0.625rem] tracking-[0.18em] text-navy-400 uppercase">
              Global Pvt Ltd
            </span>
          </span>
        </div>
        <p class="mt-5 max-w-[42ch] text-[0.9375rem] leading-relaxed text-navy-300">
          {site.tagline} Software, engineering, environmental and hospitality businesses, held and
          managed as a single group.
        </p>
      </div>

      <nav aria-label="Footer" class="grid grid-cols-2 gap-8 md:col-span-2 md:grid-cols-2">
        {
          site.footer.map((group) => (
            <div>
              <h2 class="eyebrow text-gold-400">{group.heading}</h2>
              <ul class="mt-5 flex flex-col gap-3">
                {group.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-[0.9375rem] text-navy-200 transition-colors duration-200 hover:text-gold-400"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="rule-gold mt-14 mb-8 opacity-60"></div>

    <!-- Statutory disclosures. Indian company law and the IT Rules both require these. -->
    <div class="grid gap-8 md:grid-cols-2">
      <dl class="grid gap-x-6 gap-y-2 text-[0.8125rem] text-navy-300 sm:grid-cols-[auto_1fr]">
        <dt class="font-medium text-navy-200">Registered name</dt>
        <dd>{site.legalName}</dd>
        <dt class="font-medium text-navy-200">CIN</dt>
        <dd class="font-mono">{site.legal.cin}</dd>
        <dt class="font-medium text-navy-200">Registered office</dt>
        <dd>{site.legal.registeredOffice}</dd>
      </dl>

      <dl class="grid gap-x-6 gap-y-2 text-[0.8125rem] text-navy-300 sm:grid-cols-[auto_1fr]">
        <dt class="font-medium text-navy-200">Grievance officer</dt>
        <dd>{site.legal.grievanceOfficer.name}</dd>
        <dt class="font-medium text-navy-200">Email</dt>
        <dd>
          <a href="/grievance" class="text-gold-400 underline underline-offset-4"> {site.legal.grievanceOfficer.email} </a>
        </dd>
        <dt class="font-medium text-navy-200">Response time</dt>
        <dd>
          Acknowledged in {site.legal.grievanceOfficer.acknowledgementWindow}, resolved within{" "}
          {site.legal.grievanceOfficer.resolutionWindow}
        </dd>
      </dl>
    </div>

    <div
      class="mt-12 flex flex-col gap-4 border-t border-navy-800 pt-6 text-[0.8125rem] text-navy-400 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {site.legalName}. All rights reserved.</p>
      <p class="flex items-center gap-2">
        <span
          class="inline-block h-1.5 w-1.5 rotate-45 bg-green-500"
          aria-hidden="true"
        ></span>
        Hikkari is a product of {site.brandName}
      </p>
    </div>
  </div>
</footer>
