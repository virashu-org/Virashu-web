---
interface Props {
  status: "operating" | "mandate";
  tone?: "dark" | "light";
}

const { status, tone = "dark" } = Astro.props;

const label = status === "operating" ? "Operating now" : "Chartered, not yet trading";
---

<span
  class:list={[
    "eyebrow inline-flex items-center gap-2 border px-2.5 py-1.5",
    status === "operating"
      ? tone === "light"
        ? "border-green-500/50 text-green-300"
        : "border-green-700/40 text-green-700"
      : tone === "light"
        ? "border-navy-200/25 text-navy-300"
        : "border-ink-3/35 text-ink-3",
  ]}
  style="border-radius: var(--radius-xs)"
>
  <!-- Shape carries the meaning too, so the state is never colour alone. -->
  {
    status === "operating" ? (
      <span class="inline-block h-1.5 w-1.5 rotate-45 bg-current" aria-hidden="true" />
    ) : (
      <span class="inline-block h-1.5 w-1.5 border border-current" aria-hidden="true" />
    )
  }
  {label}
</span>
