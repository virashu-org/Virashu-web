---
import Logo from "./Logo.astro";
import { site } from "../data/site";

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== "/" && path.startsWith(`${href}/`));
---

<header
  class="sticky top-0 z-40 border-b border-navy-900/10 bg-paper/90 backdrop-blur-md supports-[backdrop-filter]:bg-paper/75"
>
  <div class="shell flex h-16 items-center justify-between gap-6 md:h-[72px]">
    <a href="/" class="flex items-center gap-2.5" aria-label={`${site.brandName} home`}>
      <Logo variant="emblem" height={30} />
      <span class="flex flex-col leading-none">
        <span class="wordmark text-[1.0625rem] text-navy-800 uppercase">{site.brandName}</span>
        <span class="mt-1 font-mono text-[0.625rem] tracking-[0.18em] text-ink-3 uppercase">
          Global Pvt Ltd
        </span>
      </span>
    </a>

    <!-- Desktop: single line, never wraps. -->
    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-8">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "text-[0.9375rem] transition-colors duration-200 hover:text-navy-950",
                  isActive(item.href)
                    ? "text-navy-950 font-medium underline decoration-gold-500 decoration-2 underline-offset-[6px]"
                    : "text-ink-2",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden md:block">
      <a
        href="/contact"
        class="inline-flex h-10 items-center border border-navy-950/20 px-5 text-[0.9375rem] font-medium text-navy-950 transition-colors duration-200 hover:border-gold-600 hover:bg-gold-500/10"
        style="border-radius: var(--radius-xs)"
      >
        Start a conversation
      </a>
    </div>

    <button
      type="button"
      id="nav-toggle"
      class="inline-flex h-11 w-11 items-center justify-center md:hidden"
      aria-expanded="false"
      aria-controls="nav-mobile"
    >
      <span class="sr-only">Open menu</span>
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
        <path d="M2 6h18M2 11h18M2 16h18" stroke="currentColor" stroke-width="1.6" />
      </svg>
    </button>
  </div>

  <div id="nav-mobile" hidden class="border-t border-navy-900/10 bg-paper md:hidden">
    <nav aria-label="Primary mobile" class="shell py-4">
      <ul class="flex flex-col">
        {
          site.nav.map((item) => (
            <li class="border-b border-navy-900/8 last:border-b-0">
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class="flex min-h-12 items-center py-3 text-base text-navy-950"
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href="/contact"
            class="mt-3 inline-flex h-12 items-center border border-navy-950/20 px-5 font-medium text-navy-950"
            style="border-radius: var(--radius-xs)"
          >
            Start a conversation
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const panel = document.getElementById("nav-mobile");

  if (toggle && panel) {
    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!open));
      panel.hidden = open;
      toggle.querySelector(".sr-only")!.textContent = open ? "Open menu" : "Close menu";
    });
  }
</script>
