---
import { urlFor } from '../sanity/lib/image';
import { formatDateShort } from '../lib/format';

export type CaseStudyCardData = {
  title: string | null;
  slug: string | null;
  client: string | null;
  industry: string | null;
  summary: string | null;
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  coverImage?: any;
  publishedAt?: string | null;
  services?: string[] | null;
};

interface Props {
  caseStudy: CaseStudyCardData;
}

const { caseStudy } = Astro.props;
const image = caseStudy.coverImage?.asset
  ? urlFor(caseStudy.coverImage).width(880).height(520).fit('crop').auto('format').url()
  : null;
const date = formatDateShort(caseStudy.publishedAt);
---

<article class="group flex flex-col border border-navy-900/12 bg-paper transition-colors duration-200 hover:border-gold-600/40" style="border-radius: var(--radius-xs)">
  <a href={`/case-studies/${caseStudy.slug}`} class="flex h-full flex-col">
    {image && (
      <img
        src={image}
        alt={caseStudy.coverImage?.alt ?? ''}
        loading="lazy"
        decoding="async"
        class="aspect-[16/10] w-full object-cover"
      />
    )}
    <div class="flex flex-1 flex-col p-6">
      <div class="flex flex-wrap items-center gap-3">
        {caseStudy.industry && <span class="eyebrow text-gold-700">{caseStudy.industry}</span>}
        {date && <span class="eyebrow text-ink-3">{date}</span>}
      </div>
      <h3 class="mt-3 text-h3 text-ink transition-colors duration-200 group-hover:text-gold-700">
        {caseStudy.title}
      </h3>
      {caseStudy.client && <p class="mt-2 text-[0.875rem] text-ink-3">{caseStudy.client}</p>}
      {caseStudy.summary && (
        <p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-ink-2">{caseStudy.summary}</p>
      )}
    </div>
  </a>
</article>
