---
import { urlFor } from '../../sanity/lib/image';

interface Props {
  node: {
    alt?: string;
    caption?: string;
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    asset?: any;
  };
}

const { node } = Astro.props;
const alt = node?.alt ?? '';
const src = node?.asset
  ? urlFor(node).width(1400).fit('max').auto('format').url()
  : undefined;
---

{
  src && (
    <figure class="my-8">
      <img
        src={src}
        alt={alt}
        loading="lazy"
        decoding="async"
        class="w-full"
        style="border-radius: var(--radius-xs)"
      />
      {node.caption && (
        <figcaption class="mt-3 text-[0.8125rem] text-ink-3">{node.caption}</figcaption>
      )}
    </figure>
  )
}
