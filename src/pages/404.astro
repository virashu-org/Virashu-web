---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const links = [
  { label: "The group", href: "/group", note: "Seven chartered sectors, and which are trading." },
  { label: "Hikkari", href: "/hikkari", note: "The blind bidding marketplace for phone repairs." },
  { label: "About", href: "/about", note: "What the name and the corporate mark mean." },
  { label: "Contact", href: "/contact", note: "Group enquiries, vendor onboarding and support." },
];
---

<BaseLayout
  title="Page not found"
  description="That page does not exist. Here is where to go instead."
>
  <section class="field-dark">
    <div class="shell py-24 md:py-32">
      <p class="eyebrow text-gold-400">Error 404</p>
      <h1 class="text-h1 mt-6 max-w-[20ch] text-navy-50">
        That page is not here.
      </h1>
      <p class="text-lede mt-6 max-w-[52ch] leading-relaxed text-navy-200">
        The link may be out of date, or the page may have moved. Everything on the site is reachable
        from the four links below.
      </p>
    </div>
  </section>

  <section class="border-t border-navy-900/10 bg-paper">
    <div class="shell py-16 md:py-24">
      <h2 class="eyebrow text-ink-3">Where to go instead</h2>

      <ul class="mt-10 grid gap-px overflow-hidden border border-navy-900/12 bg-navy-900/12 sm:grid-cols-2">
        {
          links.map((l) => (
            <li class="bg-paper">
              <a href={l.href} class="flex h-full flex-col p-7 transition-colors duration-200 hover:bg-paper-3">
                <span class="flex items-center gap-3 font-medium text-ink">
                  <span class="inline-block h-2 w-2 rotate-45 bg-gold-600" aria-hidden="true" />
                  {l.label}
                </span>
                <span class="mt-3 text-[0.9375rem] leading-relaxed text-ink-2">{l.note}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="mt-12 text-[0.875rem] text-ink-3">
        If you followed a link from {site.brandName} and it landed here, tell us on the
        <a href="/contact" class="text-gold-700 underline underline-offset-4">contact page</a> and we
        will fix it.
      </p>
    </div>
  </section>
</BaseLayout>
