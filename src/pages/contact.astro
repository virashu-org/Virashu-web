---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import { getSiteSettings } from '../sanity/lib/site';

const settings = await getSiteSettings(Astro.cookies);

const channels = [
  {
    heading: 'General and partnership',
    detail: settings.legal.email,
    note: 'Group matters, subsidiary enquiries, joint ventures and supplier conversations.',
  },
  {
    heading: 'Hikkari vendor onboarding',
    detail: settings.legal.email,
    note: 'Repair shops registering for verified leads and blind bidding.',
  },
  {
    heading: 'Hikkari customer support',
    detail: settings.legal.email,
    note: 'Quotes, warranties, and jobs in progress.',
  },
];
---

<BaseLayout
  settings={settings}
  title="Contact"
  description="Contact Virashu Private Limited for group enquiries, partnerships, Hikkari vendor onboarding and support."
>
  <PageHeader
    eyebrow="Contact"
    title="Start with the right desk."
    lede="Group matters, vendor onboarding, customer support and grievances each have their own route. Choosing the right one gets you a faster answer."
  />

  <section class="border-t border-navy-900/10 bg-paper">
    <div class="shell py-20 md:py-28">
      <div class="grid gap-16 lg:grid-cols-[1.15fr_0.85fr] lg:gap-20">
        <div>
          <h2 class="text-h2 text-ink">Send a message</h2>
          <p class="measure mt-4 leading-relaxed text-ink-2">
            Fields are labelled, and nothing is sent until the form validates. If anything looks
            wrong, the field itself tells you why.
          </p>
          <div class="mt-10">
            <ContactForm />
          </div>
        </div>

        <div>
          <h2 class="text-h2 text-ink">Direct channels</h2>

          <dl class="mt-8 flex flex-col gap-px overflow-hidden border border-navy-900/12 bg-navy-900/12">
            {
              channels.map((c) => (
                <div class="bg-paper p-6">
                  <dt class="font-medium text-ink">{c.heading}</dt>
                  <dd class="mt-2 font-mono text-[0.875rem] text-gold-700">{c.detail}</dd>
                  <dd class="mt-3 text-[0.875rem] leading-relaxed text-ink-2">{c.note}</dd>
                </div>
              ))
            }
          </dl>

          <div class="mt-10 border-t border-navy-900/12 pt-8">
            <h3 class="eyebrow text-ink-3">Registered office</h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-2">
              {settings.legal.registeredOffice}
            </p>
            <p class="mt-2 font-mono text-[0.8125rem] text-ink-3">CIN {settings.legal.cin}</p>
          </div>

          <div class="mt-8 border-t border-navy-900/12 pt-8">
            <h3 class="eyebrow text-ink-3">Grievance</h3>
            <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-2">
              Complaints follow a separate, time-bound process with a named officer.
            </p>
            <a
              href="/grievance"
              class="mt-4 inline-flex text-[0.9375rem] font-medium text-gold-700 underline underline-offset-4"
            >
              Grievance redressal
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
