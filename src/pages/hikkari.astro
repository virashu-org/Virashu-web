---
import BaseLayout from "../layouts/BaseLayout.astro";
import BidStream from "../components/BidStream.astro";
import Logo from "../components/Logo.astro";
import { hikkari, site } from "../data/site";
---

<BaseLayout
  title="Hikkari"
  description="Hikkari is a mobile repair marketplace for India. Customers get competing quotes from verified local vendors through a blind bidding system that no vendor can see into."
>
  <!-- Product register: denser, more instrument than brochure. -->
  <section class="field-dark relative overflow-hidden">
    <div class="shell relative py-16 md:py-24">
      <div class="flex items-center gap-3">
        <Logo size={24} tone="light" />
        <p class="eyebrow text-gold-400">{hikkari.name} · {hikkari.category}</p>
      </div>

      <h1 class="text-h1 mt-7 max-w-[21ch] text-navy-50">
        Repair quotes that compete, not quotes you have to trust.
      </h1>

      <p class="text-lede mt-6 max-w-[58ch] leading-relaxed text-navy-200">
        {hikkari.problem}
      </p>

      <dl class="mt-12 grid gap-px overflow-hidden border border-navy-800 bg-navy-800 sm:grid-cols-3">
        <div class="bg-navy-950 px-5 py-5">
          <dt class="eyebrow text-navy-500">Market</dt>
          <dd class="mt-2 text-navy-100">{hikkari.market}</dd>
        </div>
        <div class="bg-navy-950 px-5 py-5">
          <dt class="eyebrow text-navy-500">Vendor side</dt>
          <dd class="mt-2 text-navy-100">WhatsApp, no app install</dd>
        </div>
        <div class="bg-navy-950 px-5 py-5">
          <dt class="eyebrow text-navy-500">Auction type</dt>
          <dd class="mt-2 text-navy-100">Blind, real time</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- The mechanic, with the working feed beside it. -->
  <section class="bg-paper-2">
    <div class="shell py-20 md:py-28">
      <p class="eyebrow text-ink-3">The mechanic</p>
      <h2 class="text-h2 mt-5 max-w-[28ch] text-ink">
        Four steps, and the vendors only ever see one of them.
      </h2>

      <div class="mt-14 grid gap-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
        <ol class="flex flex-col">
          {
            hikkari.mechanic.map((step, i) => (
              <li class="flex gap-5 border-t border-navy-900/12 py-6 first:border-t-0 first:pt-0">
                <span class="eyebrow mt-1 shrink-0 text-gold-700">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div>
                  <h3 class="text-h3 text-ink">{step.step}</h3>
                  <p class="mt-2 max-w-[54ch] text-[0.9375rem] leading-relaxed text-ink-2">
                    {step.body}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>

        <div>
          <BidStream />
          <p class="mt-5 max-w-[58ch] text-[0.875rem] leading-relaxed text-ink-2">
            Multi-tier quotes are the point. A compatible part at ₹1,850 with 30 days of warranty and
            an original at ₹4,850 with 180 days are different offers, and the customer can see that.
            Vendors compete on price, part tier, warranty and turnaround at the same time.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-paper">
    <div class="shell py-20 md:py-28">
      <p class="eyebrow text-ink-3">Capabilities</p>
      <h2 class="text-h2 mt-5 max-w-[24ch] text-ink">What the platform actually does.</h2>

      <div class="mt-14 grid gap-px overflow-hidden border border-navy-900/12 bg-navy-900/12 md:grid-cols-2 lg:grid-cols-3">
        {
          hikkari.features.map((f) => (
            <article class="flex flex-col bg-paper p-7">
              <span
                class="inline-block h-2.5 w-2.5 rotate-45 bg-gold-600"
                aria-hidden="true"
              />
              <h3 class="mt-5 font-medium text-ink">{f.title}</h3>
              <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-2">{f.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Two audiences, opposite needs. Presented as two columns rather than tabs
       so a reader can compare them without interaction. -->
  <section class="field-dark">
    <div class="shell py-20 md:py-28">
      <p class="eyebrow text-gold-400">Two sides, opposite incentives</p>
      <h2 class="text-h2 mt-5 max-w-[26ch] text-navy-50">
        The customer wants the lowest price. The shop wants to hold its margin.
      </h2>

      <div class="mt-14 grid gap-px overflow-hidden border border-navy-800 bg-navy-800 md:grid-cols-2">
        {
          hikkari.audiences.map((a) => (
            <div class="bg-navy-950 p-8">
              <h3 class="text-h3 text-navy-50">{a.name}</h3>
              <p class="mt-4 leading-relaxed text-navy-300">{a.body}</p>
              <ul class="mt-6 flex flex-col gap-3">
                {a.points.map((p) => (
                  <li class="flex items-start gap-3 text-[0.9375rem] text-navy-200">
                    <span
                      class="mt-2 inline-block h-1.5 w-1.5 shrink-0 rotate-45 bg-green-500"
                      aria-hidden="true"
                    />
                    {p}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-t border-navy-900/10 bg-paper">
    <div class="shell py-20 md:py-24">
      <p class="eyebrow text-ink-3">Engineering</p>
      <h2 class="text-h2 mt-5 max-w-[26ch] text-ink">Built on infrastructure that has to hold up under live bidding.</h2>

      <dl class="mt-14 grid gap-x-12 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {
          hikkari.stack.map((s) => (
            <div class="border-t border-navy-900/12 pt-5">
              <dt class="eyebrow text-ink-3">{s.group}</dt>
              <dd class="mt-4 flex flex-col gap-2">
                {s.items.map((item) => (
                  <span class="font-mono text-[0.8125rem] text-ink-2">{item}</span>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-16 border border-navy-900/12 bg-paper-2 p-8">
        <h3 class="text-h3 text-ink">Privacy in the vision pipeline</h3>
        <p class="measure mt-4 leading-relaxed text-ink-2">
          A photo of a broken phone is also a photo of whatever was on the screen. Blur detection, OCR
          and face redaction run on our side before any image reaches a cloud model, so answering a
          repair question does not require uploading a customer's contacts, messages or photographs.
        </p>
        <a
          href="/privacy"
          class="mt-6 inline-flex text-[0.9375rem] font-medium text-gold-700 underline underline-offset-4"
        >
          How we handle personal data
        </a>
      </div>
    </div>
  </section>

  <section class="field-dark">
    <div class="shell py-16 md:py-20">
      <div class="flex flex-wrap items-center justify-between gap-8">
        <div>
          <h2 class="text-h2 max-w-[24ch] text-navy-50">Are you a repair shop near a dense market?</h2>
          <p class="mt-4 max-w-[52ch] leading-relaxed text-navy-300">
            Onboarding runs on OTP and KYC, and the bids run on WhatsApp. There is nothing to install.
          </p>
        </div>
        <a
          href="/contact"
          class="inline-flex h-12 items-center bg-gold-500 px-6 font-medium text-navy-950 transition-colors duration-200 hover:bg-gold-400"
          style="border-radius: var(--radius-xs)"
        >
          Register as a vendor
        </a>
      </div>

      <p class="mt-12 border-t border-navy-800 pt-6 text-[0.8125rem] text-navy-400">
        {hikkari.name} is a product of {site.legalName}.
      </p>
    </div>
  </section>
</BaseLayout>
