# Canonical origin used for canonicals, og:url and JSON-LD.
# Falls back to VERCEL_URL, then https://www.virashu.com
SITE_URL=https://www.virashu.com

# --- Sanity (public: safe to expose to the browser) -------------------------
PUBLIC_SANITY_PROJECT_ID=ymsvmpl7
PUBLIC_SANITY_DATASET=production
# Origin of the standalone Studio (../studio-higsboson). Used by the
# visual-editing overlays to build click-to-edit links. `sanity dev` serves on
# :3333; in production set this to the deployed Studio URL.
PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# --- Sanity (server-only) ---------------------------------------------------
# An API token with the Viewer role. Required for draft mode / visual editing.
SANITY_API_READ_TOKEN=your-viewer-token
